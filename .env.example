# Copy this file to .env and fill in real values. Never commit .env.

# --- cryptoflowsignals.com login (for READING signals only) ---
CFS_EMAIL=mugabeyunusu@gmail.com
CFS_PASSWORD=2100800069@Allan
CFS_LOGIN_URL=https://cryptoflowsignals.com/auth
CFS_SIGNALS_URL=https://cryptoflowsignals.com/signals/live

# --- Binance Futures API (for EXECUTING trades) ---
# Create this key with Futures trading enabled, withdrawals DISABLED,
# and restricted to your machine's public IP (see README).
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret
# Set to true while testing — no real orders are placed.
BINANCE_TESTNET=true

# --- Safety rails ---
DRY_RUN=true
POLL_INTERVAL_SECONDS=15

# --- Execution filters ---
MIN_CONFIDENCE=70
SKIP_AGED=true
SKIP_HIGH_RISK=false
MAX_SIGNAL_AGE_MINUTES=25
# Skip signals where "Progress to TP3" has already moved past this %.
MAX_PROGRESS_PCT=10

# --- Trade parameters ---
LEVERAGE=4
MARGIN_USDT=24
